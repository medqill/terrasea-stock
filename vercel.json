{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/**",
          "views/**",
          "data/processed/**",
          "data/geo/**"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/css/(.*)",    "dest": "/public/css/$1" },
    { "src": "/js/(.*)",     "dest": "/public/js/$1" },
    { "src": "/vendor/(.*)", "dest": "/public/vendor/$1" },
    { "src": "/img/(.*)",    "dest": "/public/img/$1" },
    { "src": "/(.*)",        "dest": "/api/index.js" }
  ],
  "env": {
    "NODE_ENV": "production",
    "TRUST_PROXY": "1"
  }
}

