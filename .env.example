PORT=3000
NODE_ENV=development

# URL aplikasi untuk tautan email verifikasi (misal https://terrasea-stock.vercel.app di produksi)
APP_URL=http://localhost:3000

# Rahasia sesi minimal 32 karakter untuk menandatangani cookie sesi (WAJIB di produksi)
SESSION_SECRET=xxxx

# Set ke 1 bila berada di balik reverse proxy Vercel (agar rate limiter membaca IP asli)
TRUST_PROXY=1

# Basis data Turso (libSQL)
# Lokal: file:data/local.db
# Produksi: libsql://<database-anda>.turso.io
TURSO_DATABASE_URL=file:data/local.db
TURSO_AUTH_TOKEN=xxxx

# Upstash Redis untuk Rate Limiting terdistribusi (kosongkan di lokal dev untuk fail-open memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Basemap MapTiler Dataviz. Batasi domain di dashboard cloud MapTiler.
MAPTILER_KEY=xxxx
MAPTILER_MAP_ID=01a1b64a-14ea-71b6-b302-10912b921ef0

# SMTP untuk pengiriman email verifikasi pendaftaran akun
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="terrasea-stock <no-reply@example.ac.id>"
